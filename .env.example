# Porta do servidor Express / Vite
PORT=3000

# Modo de execução ('development' ou 'production')
NODE_ENV=development

# URL da aplicação
APP_URL=http://localhost:3000

# Configuração Opcional de Banco de Dados Remoto (PostgreSQL / Supabase / Neon / Railway)
# Se não preenchido, o sistema utiliza armazenamento persistente local em /data
# DATABASE_URL=postgresql://postgres:suasenha@localhost:5432/financas
